# Copy to .env (never commit it) or set these in your host's secrets.

# Nebius AI Studio (OpenAI-compatible). Leave empty to run with the built-in keyword reader and summary.
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
# Check the exact model name against Nebius's current model list before launch.
COURT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# COURT_AI=off                 # force the AI off even with a key

# Tokens offered in the picker (Bitget spot symbols).
# COURT_TOKENS=rAAPLUSDT,rTSLAUSDT,rNVDAUSDT,rMSFTUSDT,rGOOGLUSDT,rAMZNUSDT,rMETAUSDT,rCOINUSDT

# Per-visitor limits over COURT_RATE_WINDOW_SECONDS (default 600).
# COURT_RATE_LIMIT=60          # rulings and readings
# COURT_AI_LIMIT=20            # AI calls; past this the keyword reader and template take over
# COURT_TRUST_PROXY=on         # read the visitor's address from X-Forwarded-For (set off if not behind a proxy)

# BITGET_BASE_URL=https://api.bitget.com
# COURT_SNAPSHOT_DIR=data/snapshots
